{
  "name": "thiep-hong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "emulators": "firebase emulators:start --project demo-thiephong",
    "seed": "tsx scripts/seed.mts",
    "build": "next build",
    "preview": "next build && npm run emulators",
    "deploy": "next build && firebase deploy --only hosting,firestore",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-thiephong \"vitest run --config vitest.rules.config.mts\"",
    "check": "run-s typecheck lint format:check test test:rules"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^13.4.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@next/env": "^16.4.6",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true,
    "@firebase/util": false,
    "protobufjs": false,
    "re2": false
  }
}
