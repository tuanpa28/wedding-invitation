# Copy thành .env.local.

# --- Chạy ở máy local với Firebase Emulator (không cần project thật) ---
# true: trang thiệp/quản lý đọc ghi Firestore Emulator (npm run emulators)
NEXT_PUBLIC_FIREBASE_EMULATOR=true

# --- Project Firebase thật (Firebase Console → Project settings → Your apps → Web app) ---
# Đây là cấu hình công khai; bảo mật nằm ở firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Địa chỉ thiệp sau khi deploy (dùng cho ảnh preview khi share link), vd. https://ten-project.web.app
NEXT_PUBLIC_SITE_URL=

# --- Chỉ dùng cho npm run seed -- --prod (không đưa lên Hosting) ---
# Email Google của người quản trị, cách nhau bằng dấu phẩy
ADMIN_EMAILS=
# Đường dẫn file khoá service account (KHÔNG commit file này)
GOOGLE_APPLICATION_CREDENTIALS=
