# Copy thành .env.local khi chạy ở máy local.
# Postgres local (docker compose). Trên Vercel thay bằng connection string của Neon.
DATABASE_URL=postgres://thiephong:thiephong@localhost:5434/thiephong

# Khoá bí mật cho POST /api/revalidate (xoá cache thiệp). Tạo chuỗi ngẫu nhiên dài.
REVALIDATE_SECRET=change-me
