# Copy thành .env.local khi chạy ở máy local.
# Postgres local (docker compose). Trên Vercel thay bằng connection string của Neon.
DATABASE_URL=postgres://thiephong:thiephong@localhost:5434/thiephong

# Khoá bí mật cho POST /api/revalidate (xoá cache thiệp). Tạo chuỗi ngẫu nhiên dài.
REVALIDATE_SECRET=change-me

# --- Đăng nhập (Better Auth) ---
# Chuỗi ngẫu nhiên ≥ 32 ký tự: npx @better-auth/cli secret  (hoặc openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Địa chỉ app (trên Vercel: https://<tên-app>.vercel.app)
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (xem README → Đăng nhập Google). Để trống thì nút Google bị tắt.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Đăng nhập thử bằng email + mật khẩu khi chưa có Google.
# Chỉ hoạt động khi DATABASE_URL trỏ tới Postgres trên máy (localhost). Không đặt trên Vercel.
DEV_LOGIN=true

# --- Upload ảnh/nhạc (Cloudinary, xem README) ---
# Để trống thì nút tải ảnh/nhạc bị tắt.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
